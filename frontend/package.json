  ],
  "dependencies": {
    "@angular/animations": "22.3.0",
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/material": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "material-icons": "1.13.14",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zone.js": "0.16.3"
  },
  "description": "A tool that shows how public data can be accessed from Instagram without an Instagram account.",
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@cypress/schematic": "6.0.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/jasmine": "7.0.0",
    "angular-eslint": "22.8.0",
    "cypress": "16.3.0",
    "eslint": "10.15.0",
    "jasmine-core": "7.0.2",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.3.0",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "homepage": "https://publicmedia.inpercima.net/",
  "license": "MIT",
  "name": "publicmedia",
  "packageManager": "pnpm@12.21.0",
  "private": true,
  "repository": "https://github.com/inpercima/publicmedia/",
  "scripts": {
    "build:dev": "ng lint && ng build --configuration=development && node --run copy:api",
    "build:prod": "ng lint && ng build && node --run copy:api",
    "copy:api": "node -e \"const fs = require('node:fs'); const path = require('node:path'); fs.cpSync('../api', 'dist/browser/api', { recursive: true, filter: src => !['config.default.php', 'config.dev.php', 'README.md'].includes(path.basename(src)) });\"",
    "proxy": "ng serve -o --configuration=development --proxy-config src/proxy.conf.json",
    "start": "ng serve -o --configuration=development"
  },
  "version": "1.0.0-SNAPSHOT"
}
